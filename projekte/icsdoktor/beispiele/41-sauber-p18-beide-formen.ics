DTSTART:20260901T090000Z
SUMMARY:Beide erlaubten Formen des TRIGGER
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Fuenfzehn Minuten vorher
TRIGGER:-PT15M
END:VALARM
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Zu einem festen Zeitpunkt
TRIGGER;VALUE=DATE-TIME:19980101T050000Z
END:VALARM
END:VEVENT
END:VCALENDAR
